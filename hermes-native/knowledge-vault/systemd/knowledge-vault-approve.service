[Unit]
Description=Knowledge vault approval bridge (stand-in for the proposal API)
Documentation=file:///opt/knowledge-vault/README.md

[Service]
Type=oneshot
User=knowledge-vault-review
Group=knowledge-vault
WorkingDirectory=/var/lib/knowledge-vault
# Joins a proposal with its recorded decision. Delete this unit and the script
# once the proposal API owns approval records.
ExecStart=/opt/knowledge-vault/.venv/bin/python /opt/knowledge-vault/approve_locally.py \
  /var/lib/knowledge-vault/proposals \
  /var/lib/knowledge-vault/decisions \
  /var/lib/knowledge-vault/approved

ReadWritePaths=/var/lib/knowledge-vault/approved
ReadOnlyPaths=/var/lib/knowledge-vault/proposals /var/lib/knowledge-vault/decisions

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
