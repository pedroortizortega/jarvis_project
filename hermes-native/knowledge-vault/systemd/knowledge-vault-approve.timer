[Unit]
Description=Join approved proposals with their decisions

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
# The cycle is idempotent: a run with nothing to do costs a few milliseconds
# and writes nothing, so a missed run simply happens next time.
Persistent=false
AccuracySec=15s

[Install]
WantedBy=timers.target
