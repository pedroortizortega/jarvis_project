[Unit]
Description=Mirror published notes to the private git remote

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
# The cycle is idempotent: a run with nothing to do costs a few milliseconds
# and writes nothing, so a missed run simply happens next time.
Persistent=false
AccuracySec=15s

[Install]
WantedBy=timers.target
