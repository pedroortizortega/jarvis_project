[Unit]
Description=Knowledge vault promote: audited pending/ -> knowledge/ (D-04, unattended)
Documentation=file:///opt/knowledge-vault/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=knowledge-vault-promote
Group=knowledge-vault
WorkingDirectory=/opt/knowledge-vault/tree
Environment=KNOWLEDGE_VAULT_DIR=/opt/knowledge-vault/tree
Environment=KNOWLEDGE_VAULT_INDEX=/var/lib/knowledge-vault/index/index.json
Environment=KNOWLEDGE_VAULT_REMOTE=/srv/git/knowledge-vault.git
Environment=KNOWLEDGE_VAULT_BRANCH=main
# ProtectHome=yes blocks /home entirely, but the account's passwd entry
# still names /home/knowledge-vault-promote as its home directory (useradd
# --no-create-home sets the field without creating the path) — left
# unset, git falls back to that unreachable path for its own optional
# global config/attributes lookups. Pointed inside the sandbox instead so
# nothing git does ever needs a path outside what's already granted.
Environment=HOME=/opt/knowledge-vault/tree
ExecStart=/opt/knowledge-vault/.venv/bin/knowledge-vault-promote

# promote is the sole writer to knowledge/ (D-04): the pending/ -> knowledge/
# boundary is enforced twice, here via ReadWritePaths and again by
# filesystem ownership/mode (install-host.sh). It also commits+pushes .git
# and takes the vault lock, which is a file at the tree root
# (layout.vault_lock() -> <tree>/.vault.lock, not a separate state file) —
# the "-" prefix tolerates a fresh tree where the lock file does not exist
# yet on the very first run. build_index() (D-07) writes the index dir.
#
# Found live on trantor: /srv/git/knowledge-vault.git (KNOWLEDGE_VAULT_REMOTE
# above) was missing here entirely — same gap as knowledge-vault-sync.service,
# found there first when its push failed under real content.
ReadWritePaths=/opt/knowledge-vault/tree/.git /opt/knowledge-vault/tree/knowledge /opt/knowledge-vault/tree/pending -/opt/knowledge-vault/tree/.vault.lock /var/lib/knowledge-vault/index /var/lib/knowledge-vault/state /srv/git/knowledge-vault.git

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# The vault tree's own .git and the bare remote are group-shared
# (core.sharedRepository=group), which makes git mark directories setgid so
# both the promote and sync accounts keep write access (F-6). RestrictSUIDSGID
# forbids exactly that, and the commit/push would fail with EPERM, so it is
# deliberately absent here — the same reasoning the old mirror.service
# recorded for the same shared-repo pattern.
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
