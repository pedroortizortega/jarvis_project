[Unit]
Description=Knowledge vault publisher (single canonical-vault writer)
Documentation=file:///opt/knowledge-vault/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=knowledge-vault-publisher
Group=knowledge-vault
WorkingDirectory=/opt/knowledge-vault
Environment=KNOWLEDGE_VAULT_DIR=/opt/knowledge-vault/vault
Environment=KNOWLEDGE_VAULT_STATE_DIR=/var/lib/knowledge-vault/publisher
Environment=KNOWLEDGE_VAULT_APPROVED_DIR=/var/lib/knowledge-vault/approved
ExecStart=/opt/knowledge-vault/.venv/bin/knowledge-vault-publisher

# The publisher is the only unit with canonical-vault write access.
ReadWritePaths=/opt/knowledge-vault/vault /var/lib/knowledge-vault/publisher
ReadOnlyPaths=/var/lib/knowledge-vault/approved

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
