[Unit]
Description=Publish approved notes to the canonical vault

[Timer]
OnBootSec=4min
OnUnitActiveSec=3min
# The cycle is idempotent: a run with nothing to do costs a few milliseconds
# and writes nothing, so a missed run simply happens next time.
Persistent=false
AccuracySec=15s

[Install]
WantedBy=timers.target
