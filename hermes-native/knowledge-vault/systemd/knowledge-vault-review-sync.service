[Unit]
Description=Knowledge vault review queue sync for mobile clients
Documentation=file:///opt/knowledge-vault/README.md

[Service]
Environment=HOME=/var/lib/knowledge-vault/review
Type=oneshot
User=knowledge-vault-review
Group=knowledge-vault
WorkingDirectory=/var/lib/knowledge-vault/review
Environment=KNOWLEDGE_VAULT_PENDING_DIR=/var/lib/knowledge-vault/pending
Environment=KNOWLEDGE_VAULT_REVIEW_REPO=/var/lib/knowledge-vault/review/repo
# The bare repository lives on this host, so this needs no network at all:
# the phone reaches it over SSH by itself.
Environment=KNOWLEDGE_VAULT_REVIEW_REMOTE=/srv/git/knowledge-vault.git
ExecStart=/opt/knowledge-vault/.venv/bin/knowledge-vault-review-sync

ReadWritePaths=/var/lib/knowledge-vault/review /var/lib/knowledge-vault/pending /srv/git/knowledge-vault.git

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# The shared bare repository is group-shared, which makes git mark directories
# setgid so both accounts keep write access. RestrictSUIDSGID forbids exactly
# that, and the push fails with EPERM, so it is deliberately absent here.
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0007
