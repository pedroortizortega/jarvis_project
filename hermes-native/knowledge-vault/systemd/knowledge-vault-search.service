[Unit]
Description=Knowledge vault read-only search bridge for memory-router
Documentation=file:///opt/knowledge-vault/README.md
After=network-online.target sys-subsystem-net-devices-cni0.device
Wants=network-online.target

[Service]
Type=simple
User=knowledge-vault-search
Group=knowledge-vault
WorkingDirectory=/opt/knowledge-vault
Environment=KNOWLEDGE_VAULT_DIR=/opt/knowledge-vault/tree
Environment=KNOWLEDGE_VAULT_INDEX=/var/lib/knowledge-vault/index/index.json
Environment=KNOWLEDGE_VAULT_SEARCH_HOST=10.42.0.1
Environment=KNOWLEDGE_VAULT_SEARCH_PORT=8088
Environment=KNOWLEDGE_VAULT_SEARCH_TIMEOUT_SECONDS=5
Environment=KNOWLEDGE_VAULT_SEARCH_LIMIT_MAX=20
# Bearer token read from $CREDENTIALS_DIRECTORY/search-token — never a repo
# file, never an env var. Rotate by replacing the credential file.
LoadCredential=search-token:/etc/knowledge-vault/search-token
ExecStart=/opt/knowledge-vault/.venv/bin/knowledge-vault-search-serve
Restart=on-failure
RestartSec=5s

# Read-only on the whole vault tree and the index; only promote writes
# knowledge/ (D-04) and only promote rebuilds the index (D-07). No
# ReadWritePaths= anywhere — this unit never writes. KNOWLEDGE_VAULT_DIR
# points at the tree root, not knowledge/ directly: the knowledge/-only
# scope is enforced in code via layout.published_notes() (D-01), not by
# this unit's config, so a stray "pending" typo here can never widen it.
ReadOnlyPaths=/opt/knowledge-vault/tree /var/lib/knowledge-vault/index

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
