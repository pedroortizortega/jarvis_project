+"""subagent-model-routing: per-task ``model`` field on ``delegate_task``.
+
+Lets the caller pick a specific llama-router preset (or ``cloud``) per
+delegated subagent task instead of every child in a batch inheriting one
+call-level model. Covers: per-task resolution, pre-dispatch allowlist
+validation (fail-fast, zero spawn on any invalid model), GPU-safe wave
+scheduling (distinct local presets serialize, cloud is exempt), the schema
+deepcopy fix, and dynamic schema/description exposure of the allowlist.
+"""
+
+import json
+import threading
+import time
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from tools.delegate_tool import delegate_task
+
+
+ADDRESS_SCHEMA = {
+    "type": "object",
+    "properties": {"city": {"type": "string"}},
+    "required": ["city"],
+}
+
+
+def _make_mock_parent():
+    parent = MagicMock()
+    parent._delegate_depth = 0
+    parent._active_children = []
+    parent._active_children_lock = threading.Lock()
+    # Explicit string session_id: async dispatch persists this to sqlite
+    # (record["parent_session_id"]) and a bare MagicMock auto-attribute
+    # is not bindable there.
+    parent.session_id = "test-parent-session"
+    return parent
+
