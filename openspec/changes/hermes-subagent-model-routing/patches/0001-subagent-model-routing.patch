+class TestSchemaDeepcopyRegression:
+    def test_static_schema_unmutated_after_two_dynamic_builds(self):
+        """_build_dynamic_schema_overrides must never corrupt the static
+        DELEGATE_TASK_SCHEMA in place -- it shallow-copied only top-level
+        properties, so tasks["items"]["properties"] (nested) stayed shared
+        with whatever the dynamic path mutates. Calling it twice must not
+        change the static schema's tasks.items.properties keys."""
+        from tools.delegate_tool import DELEGATE_TASK_SCHEMA, _build_dynamic_schema_overrides
+
+        static_keys_before = set(
+            DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"][
+                "properties"
+            ].keys()
+        )
+        _build_dynamic_schema_overrides()
+        _build_dynamic_schema_overrides()
+        static_keys_after = set(
+            DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"][
+                "properties"
+            ].keys()
+        )
+        assert static_keys_after == static_keys_before
