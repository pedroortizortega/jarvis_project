+# subagent-model-routing: per-task model selection. Lets a batch task pick
+# a specific llama-router preset (or 'cloud') instead of inheriting the
+# call-level creds["model"]. Defaults mirror litellm-config.yaml's 4 entries;
+# externalized via delegation.allowed_models so a future config addition
+# doesn't require a code change (see _get_allowed_models).
+_DEFAULT_ALLOWED_MODELS = ("qwen3.5-9b", "qwen3.6-27b-q3", "qwen3.8-27b-iq2s", "cloud")
+# Models exempt from GPU-safe wave serialization -- they don't compete for
+# the single-GPU llama-router's --models-max 1 slot, so they always run
+# concurrently with whatever local-preset group is executing.
+_GPU_EXEMPT_MODELS = frozenset({"cloud"})
+
+
+def _get_allowed_models() -> List[str]:
+    """Return the configured per-task model allowlist.
+
+    Reads delegation.allowed_models via _load_config() (config.yaml >
+    _DEFAULT_ALLOWED_MODELS fallback). An absent or empty list falls back to
+    the 4 defaults so an install with no such key behaves exactly as if the
+    allowlist were hardcoded.
+    """
+    val = _load_config().get("allowed_models")
+    if isinstance(val, list) and val:
+        return [str(m) for m in val]
+    return list(_DEFAULT_ALLOWED_MODELS)
+
+
+def _resolve_task_model(t: Dict[str, Any], default_model: Optional[str]) -> Optional[str]:
+    """Resolve one task's effective model: its own 'model' field if set and
+    non-blank, else the call-level default (creds["model"])."""
+    raw = t.get("model")
+    return raw.strip() if isinstance(raw, str) and raw.strip() else default_model
+
+
+def _validate_task_models(
+    task_list: List[Dict[str, Any]], allowed: List[str]
+) -> Optional[str]:
+    """Validate every task's explicit 'model' field against the allowlist.
+
+    Returns an actionable error string naming the offending task index, the
+    invalid value, and the full list of valid choices, or None when every
+    explicit per-task model (if any) is allowed. Tasks that omit 'model'
+    entirely are never checked here -- they resolve to the call-level
+    default in _resolve_task_model.
+    """
+    for i, t in enumerate(task_list):
+        raw = t.get("model")
+        if raw is None:
+            continue
+        if not isinstance(raw, str) or not raw.strip():
+            return (
+                f"Task {i} has an invalid 'model' ({raw!r}): expected a "
+                f"non-empty string. Valid choices: {', '.join(allowed)}."
+            )
+        if raw.strip() not in allowed:
+            return (
+                f"Task {i} requested model {raw.strip()!r}, which is not "
+                f"in the delegation allowlist. Valid choices: "
+                f"{', '.join(allowed)}. Set delegation.allowed_models in "
+                f"config.yaml to change this. No subagents were spawned."
+            )
+    return None
+
+
+def _partition_gpu_waves(
+    children: List[tuple], task_models: List[Optional[str]], gpu_exempt: frozenset
+) -> "tuple[list, list]":
+    """Group built children by resolved model for GPU-safe wave scheduling.
+
+    ``children`` is the list of (task_index, task_dict, child_agent) tuples
+    already built for this batch. Returns (exempt_group, local_groups):
+
+    - ``exempt_group``: children whose resolved model is in ``gpu_exempt``
+      (e.g. 'cloud') -- always submitted immediately, never waits on or
+      blocks any local-preset group.
+    - ``local_groups``: a list of groups, one per distinct non-exempt
