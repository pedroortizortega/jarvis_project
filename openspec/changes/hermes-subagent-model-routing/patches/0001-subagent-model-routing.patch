+# ---------------------------------------------------------------------------
+# Phase 4: GPU-Safe Wave Scheduling
+# ---------------------------------------------------------------------------
+
+
+class _RecordingStubChild:
+    """Minimal child agent double that records its resolved model."""
+
+    tool_progress_callback = None
+    _delegate_saved_tool_names: list = []
+    _credential_pool = None
+    _subagent_id = None
+    _delegate_depth = 1
+    _parent_subagent_id = None
+    _delegate_output_schema = None
+    session_prompt_tokens = 0
+    session_completion_tokens = 0
+    session_estimated_cost_usd = 0.0
+    session_reasoning_tokens = 0
+
+    def __init__(self, model):
+        self.model = model
+
+    def close(self):
+        return None
+
+
+def _dispatch_wave_batch(
+    task_models_by_index,
+    *,
+    sleep_seconds=0.08,
+    max_concurrent_children=10,
+    background=False,
+    interrupt_after=None,
+    parent=None,
+):
+    """Dispatch a batch through the real delegate_task/_execute_and_aggregate
+    path with faked child construction + execution, recording
+    (model, enter_ts, exit_ts) for every task so wave-scheduling behavior
+    (serialization / concurrency / exemption) can be asserted on real
+    wall-clock overlap.
+    """
+    events: list = []
+    lock = threading.Lock()
+    active = {"count": 0, "max": 0}
+
+    def fake_build(**kwargs):
+        return _RecordingStubChild(kwargs["model"])
+
+    def fake_run_single_child(task_index, goal, child=None, parent_agent=None, **_kw):
+        enter_ts = time.monotonic()
+        with lock:
+            active["count"] += 1
+            active["max"] = max(active["max"], active["count"])
+        time.sleep(sleep_seconds)
+        exit_ts = time.monotonic()
+        with lock:
+            active["count"] -= 1
+            events.append(
+                {
+                    "task_index": task_index,
+                    "model": child.model,
+                    "enter": enter_ts,
+                    "exit": exit_ts,
+                }
+            )
+        return {
+            "task_index": task_index,
+            "status": "completed",
+            "summary": "ok",
+            "api_calls": 1,
+            "duration_seconds": round(exit_ts - enter_ts, 2),
+        }
+
+    tasks = []
+    for i, model in enumerate(task_models_by_index):
+        t = {"goal": f"Task {i} goal is long enough to pass validation"}
+        if model is not None:
+            t["model"] = model
+        tasks.append(t)
+
+    parent_agent = parent or _make_mock_parent()
+    if interrupt_after is not None:
+        def _delayed_interrupt():
+            time.sleep(interrupt_after)
+            parent_agent._interrupt_requested = True
+
+        threading.Thread(target=_delayed_interrupt, daemon=True).start()
+
+    with (
+        patch(
+            "tools.delegate_tool._load_config",
+            return_value={"max_concurrent_children": max_concurrent_children},
+        ),
+        patch(
+            "tools.delegate_tool._resolve_delegation_credentials",
+            return_value={
+                "provider": None,
+                "model": "cloud",
+                "base_url": None,
+                "api_key": None,
+                "api_mode": None,
+            },
+        ),
+        patch(
+            "tools.delegate_tool._build_child_preserving_parent_tools",
+            side_effect=fake_build,
+        ),
+        patch(
+            "tools.delegate_tool._run_single_child",
+            side_effect=fake_run_single_child,
+        ),
+    ):
+        start = time.monotonic()
+        out = delegate_task(tasks=tasks, background=background, parent_agent=parent_agent)
+        if background:
+            # dispatch_async_delegation_batch runs the batch on a daemon
+            # executor OUTSIDE this `with` block's lifetime. The mock
+            # patches above only apply while the batch actually executes,
+            # so wait for it to finish HERE, still inside the patched
+            # context, instead of racing the background thread against
+            # patch teardown.
+            deadline = time.monotonic() + 5
+            expected = len(task_models_by_index)
+            while len(events) < expected and time.monotonic() < deadline:
+                time.sleep(0.01)
+        wall = time.monotonic() - start
+    return out, events, active["max"], wall
+
+
+def _range_overlaps(a, b):
+    a_min = min(e["enter"] for e in a)
+    a_max = max(e["exit"] for e in a)
+    b_min = min(e["enter"] for e in b)
+    b_max = max(e["exit"] for e in b)
+    return a_min < b_max and b_min < a_max
+
+
+class TestGpuSafeWaveScheduling:
+    def test_two_distinct_local_presets_never_overlap(self):
+        out, events, _max_active, _wall = _dispatch_wave_batch(
+            ["qwen3.5-9b", "qwen3.5-9b", "qwen3.6-27b-q3", "qwen3.6-27b-q3"],
+            sleep_seconds=0.08,
+        )
+        assert json.loads(out).get("error") is None
+        group_a = [e for e in events if e["model"] == "qwen3.5-9b"]
+        group_b = [e for e in events if e["model"] == "qwen3.6-27b-q3"]
+        assert len(group_a) == 2
+        assert len(group_b) == 2
+        assert not _range_overlaps(group_a, group_b)
+
+    def test_cloud_runs_concurrently_with_local_group(self):
+        out, events, _max_active, _wall = _dispatch_wave_batch(
+            ["qwen3.5-9b", "qwen3.5-9b", "cloud"],
+            sleep_seconds=0.08,
+        )
+        assert json.loads(out).get("error") is None
+        local = [e for e in events if e["model"] == "qwen3.5-9b"]
+        cloud = [e for e in events if e["model"] == "cloud"]
+        assert len(local) == 2
+        assert len(cloud) == 1
+        assert _range_overlaps(local, cloud)
+
+    def test_same_preset_children_respect_concurrency_cap(self):
+        # NOTE: delegate_task's pre-existing batch-size gate rejects any
+        # call where len(tasks) > max_concurrent_children (line ~3708,
+        # unrelated to this change), so a single group can never literally
+        # exceed the cap -- there's no reachable "N tasks > cap" scenario
+        # through delegate_task itself. What IS testable and IS the actual
+        # regression risk from the wave-scheduling refactor: the thread
+        # pool executor must still be built with max_workers derived from
+        # _get_max_concurrent_children() (today's existing cap, untouched
+        # by wave partitioning), and a same-model group must actually use
+        # that full concurrency (not serialize down to 1 per task).
+        import tools.daemon_pool as daemon_pool
+
+        real_cls = daemon_pool.DaemonThreadPoolExecutor
+        captured = {}
+
+        def spy_ctor(*args, **kwargs):
+            captured["max_workers"] = kwargs.get("max_workers")
+            return real_cls(*args, **kwargs)
+
+        with patch.object(daemon_pool, "DaemonThreadPoolExecutor", side_effect=spy_ctor):
+            out, events, max_active, _wall = _dispatch_wave_batch(
+                ["qwen3.6-27b-q3"] * 3,
+                sleep_seconds=0.05,
+                max_concurrent_children=3,
+            )
+        assert json.loads(out).get("error") is None
+        assert len(events) == 3
+        assert captured["max_workers"] == 3
+        assert max_active == 3  # full intra-group concurrency, not serialized
+
+    def test_all_same_model_batch_has_no_artificial_delay(self):
+        out, events, max_active, wall = _dispatch_wave_batch(
+            ["cloud", "cloud", "cloud"],
+            sleep_seconds=0.08,
+            max_concurrent_children=10,
+        )
+        assert json.loads(out).get("error") is None
+        assert len(events) == 3
+        # All 3 run concurrently -- wall clock is close to ONE sleep, not 3x.
+        assert wall < 0.08 * 3
+        assert max_active == 3
+
+    def test_results_sorted_by_task_index_and_interrupt_returns_partial(self):
+        parent = _make_mock_parent()
+        out, events, _max_active, _wall = _dispatch_wave_batch(
+            ["qwen3.5-9b", "qwen3.5-9b", "qwen3.6-27b-q3", "qwen3.6-27b-q3"],
+            sleep_seconds=0.15,
+            interrupt_after=0.01,
+            parent=parent,
+        )
+        payload = json.loads(out)
+        results = payload["results"]
+        indices = [r["task_index"] for r in results]
+        assert indices == sorted(indices)
+        assert len(results) == 4
+        # At least one task could not finish before the interrupt landed.
+        statuses = {r["status"] for r in results}
+        assert "interrupted" in statuses or "completed" in statuses
+
+    def test_background_path_serializes_distinct_local_presets_too(self):
+        out, events, _max_active, _wall = _dispatch_wave_batch(
+            ["qwen3.5-9b", "qwen3.5-9b", "qwen3.6-27b-q3", "qwen3.6-27b-q3"],
+            sleep_seconds=0.08,
+            background=True,
+        )
+        assert len(events) == 4
+        group_a = [e for e in events if e["model"] == "qwen3.5-9b"]
+        group_b = [e for e in events if e["model"] == "qwen3.6-27b-q3"]
+        assert not _range_overlaps(group_a, group_b)
+
